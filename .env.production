# ============================================
# Production Environment Configuration
# Copy to .env and update values for deployment
# ============================================

# Application
ENVIRONMENT=production
DEBUG=false

# Database (connection string constructed in docker-compose)
POSTGRES_DB=homedb
POSTGRES_USER=homeuser
# Password loaded from secrets/db_password.txt

# Security (loaded from secrets files)
# JWT_SECRET - loaded from secrets/jwt_secret.txt
# MFA_ENCRYPTION_KEY - loaded from secrets/mfa_encryption_key.txt

# Session Configuration
SESSION_EXPIRY_HOURS=1
TRUSTED_DEVICE_EXPIRY_DAYS=30

# File Upload Limits
MAX_FILE_SIZE_MB=20
MAX_STORAGE_PER_USER_MB=200
UPLOAD_DIR=/app/uploads

# CORS (only allow frontend)
ALLOWED_ORIGINS=http://frontend,http://localhost

# Frontend API URL
VITE_API_URL=/api
