# Home Management Platform - Environment Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENVIRONMENT=development
DEBUG=true

# Application URL (for Cloudflare Tunnel in production)
# Development: http://localhost:8000
# Production: https://home.yourdomain.com
APP_URL=http://localhost:8000

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Allowed CORS origins (comma-separated)
# Development: Include frontend dev server
# Production: Only your domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Session expiry (hours)
SESSION_EXPIRY_HOURS=1

# Trusted device remember-me duration (days)
TRUSTED_DEVICE_EXPIRY_DAYS=30

# Login throttling
MAX_LOGIN_ATTEMPTS_PER_MINUTE=10
LOGIN_LOCKOUT_MINUTES=15

# ============================================================================
# DATABASE SETTINGS
# ============================================================================

# Database connection
# Note: Password is loaded from Docker secret at runtime
# Using postgresql+psycopg:// for psycopg3 driver
DATABASE_URL=postgresql+psycopg://homeuser@db:5432/homedb

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================

# Maximum file size (MB)
MAX_FILE_SIZE_MB=20

# Maximum storage per user (MB)
MAX_STORAGE_PER_USER_MB=200

# Upload directory (inside container)
UPLOAD_DIR=/app/uploads

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/jpg,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================================================
# LOCALIZATION
# ============================================================================

# Locale (fixed for v1)
LOCALE=en_AU

# Date format (DD/MM/YYYY - fixed for v1)
DATE_FORMAT=DD/MM/YYYY

# Time format (12-hour with AM/PM - fixed for v1)
TIME_FORMAT=12h

# Currency (AUD - fixed for v1)
CURRENCY=AUD

# Financial year start month (July = 7, for ATO compliance)
FINANCIAL_YEAR_START_MONTH=7

# ============================================================================
# AUDIT LOGGING
# ============================================================================

# Retention periods (years)
AUDIT_LOG_RETENTION_TAX_YEARS=5
AUDIT_LOG_RETENTION_AUTH_YEARS=5
AUDIT_LOG_RETENTION_OTHER_YEARS=2

# ============================================================================
# CLOUDFLARE TUNNEL (Production only)
# ============================================================================

# Cloudflare Tunnel runs on the Pi host (not in Docker)
# Configure via cloudflared CLI
# See: https://developers.cloudflare.com/cloudflare-one/connections/connect-apps

# Your domain for production
# CLOUDFLARE_DOMAIN=home.yourdomain.com

# ============================================================================
# MONITORING & ALERTING (v1.1+)
# ============================================================================

# Feature flags for future features
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_BACKUPS=false
ENABLE_MONITORING=false

# ============================================================================
# DOCKER SECRETS (DO NOT SET THESE - LOADED FROM FILES)
# ============================================================================

# These are loaded from Docker secrets at runtime
# See: ./secrets/db_password.txt
# See: ./secrets/jwt_secret.txt
# See: ./secrets/mfa_encryption_key.txt

# DB_PASSWORD_FILE=/run/secrets/db_password
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# MFA_ENCRYPTION_KEY_FILE=/run/secrets/mfa_encryption_key
